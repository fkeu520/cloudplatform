<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudhub</groupId>
        <artifactId>platform-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>park-common</artifactId>
    <description>园区业务公共层 - csyh 翻译适配 (Phase -1 W2)</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 复用 platform-common (统一响应/异常/工具/多租户/MyBatis-Plus Config) -->
        <dependency>
            <groupId>com.cloudhub</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- Spring Boot Web (controller/validation 注解) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation (@Validated @Valid) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus (直接用 MP 原生 IService/ServiceImpl, 不做包装层, 见 W2.2 决策) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Spring Boot AOP (park-common.security 的 @RequiresPermissions 切面) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Hutool (工具库, 替代 cn.flyrise.common.utils.*)
             2026-06-16: 暂不引入, platform-server 暂无 hutool 依赖, Maven 镜像未配.
             W3 阶段: 评估是否引入 (若 csyh 业务模块大量使用 hutool, 则加入 platform-server 父 pom dependencyManagement) -->
        <!-- 暂未引入 hutool -->

        <!-- Jackson (替代 com.alibaba.fastjson) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Commons Lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- TransmittableThreadLocal (PC2-4: 解决 @Async 子线程上下文丢失)
             注: 离线模式下 jar 不可用, 默认注释. 待 142 可联网时启用.
             启用步骤: 取消注释 + 在 LoginContextHolder 把 ThreadLocal 改成 TransmittableThreadLocal -->
        <!-- <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
            <version>2.14.5</version>
        </dependency> -->

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
