<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudhub.platform.user.domain.mapper.DeptMapper">

    <resultMap id="BaseResultMap" type="com.cloudhub.platform.user.domain.entity.Dept">
        <id column="id" property="id" />
        <result column="org_id" property="orgId" />
        <result column="parent_id" property="parentId" />
        <result column="name" property="name" />
        <result column="code" property="code" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="deleted" property="deleted" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="selectByOrgId" resultMap="BaseResultMap">
        SELECT * FROM sys_dept 
        WHERE org_id = #{orgId} AND status = 1 AND deleted = 0 
        ORDER BY sort ASC
    </select>

    <select id="selectTreeByOrgId" resultMap="BaseResultMap">
        SELECT * FROM sys_dept 
        WHERE org_id = #{orgId} AND status = 1 AND deleted = 0 
        ORDER BY sort ASC
    </select>

</mapper>