{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "容器资源使用 - 各服务排行",
  "uid": "container-resources",
  "tags": ["platform", "container"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "id": 1, "type": "row", "title": "容器资源排行 (实时)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false, "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "容器总数",
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false} },
      "targets": [{"expr": "count(container_cpu_usage_seconds_total{name=~\"/platform-.*\", name!=\"/platform-cadvisor\"})", "refId": "A"}]
    },
    {
      "id": 3, "type": "stat", "title": "内存总使用 (容器)",
      "gridPos": {"h": 3, "w": 5, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false} },
      "targets": [{"expr": "sum(container_memory_working_set_bytes{name=~\"/platform-.*\", name!=\"/platform-cadvisor\"})", "refId": "A", "legendFormat": "total memory"}]
    },
    {
      "id": 4, "type": "stat", "title": "CPU 总使用 (容器)",
      "gridPos": {"h": 3, "w": 5, "x": 9, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false} },
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total[1m]){name=~\"/platform-.*\", name!=\"/platform-cadvisor\"})", "refId": "A", "legendFormat": "CPU cores"}]
    },
    {
      "id": 5, "type": "table", "title": "各服务内存占用排名 (实时)",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes", "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 536870912}, {"color": "red", "value": 1073741824}] }
        },
        "overrides": [{"matcher": {"id": "byName", "options": "服务名"}, "properties": [{"id": "custom.width", "value": 200}]}]
      },
      "options": { "sortBy": [{"displayName": "内存 (bytes)", "desc": true}] },
      "targets": [{"expr": "container_memory_working_set_bytes{name=~\"/platform-.*\", name!=\"/platform-cadvisor\"}", "format": "table", "instant": true, "refId": "A", "legendFormat": "{{name}}"}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true, "image": true, "interval": true },
        "indexByName": {"name": 0, "Value": 1},
        "renameByName": {"name": "服务名", "Value": "内存 (bytes)"}
      }}]
    },
    {
      "id": 6, "type": "table", "title": "各服务 CPU 使用排名 (1m avg)",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 3, "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}] }
        }
      },
      "options": { "sortBy": [{"displayName": "CPU (cores)", "desc": true}] },
      "targets": [{"expr": "rate(container_cpu_usage_seconds_total[1m]){name=~\"/platform-.*\", name!=\"/platform-cadvisor\"}", "format": "table", "instant": true, "refId": "A", "legendFormat": "{{name}}"}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true, "image": true },
        "indexByName": {"name": 0, "Value": 1},
        "renameByName": {"name": "服务名", "Value": "CPU (cores)"}
      }}]
    },
    {
      "id": 7, "type": "row", "title": "容器资源趋势",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false, "panels": []
    },
    {
      "id": 8, "type": "timeseries", "title": "各容器内存趋势 (Top 8)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10} } },
      "options": { "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"} },
      "targets": [{"expr": "topk(8, container_memory_working_set_bytes{name=~\"/platform-.*\", name!=\"/platform-cadvisor\"})", "refId": "A", "legendFormat": "{{name}}"}]
    },
    {
      "id": 9, "type": "timeseries", "title": "各容器 CPU 趋势 (Top 8)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "none", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10} } },
      "options": { "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"} },
      "targets": [{"expr": "topk(8, rate(container_cpu_usage_seconds_total[1m]){name=~\"/platform-.*\", name!=\"/platform-cadvisor\"})", "refId": "A", "legendFormat": "{{name}}"}]
    }
  ]
}
